# Flutter/Dart
*.dart text eol=lf
*.arb text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.json text eol=lf
*.md text eol=lf
*.gradle text eol=lf
*.properties text eol=lf
*.xml text eol=lf
*.html text eol=lf
*.js text eol=lf
*.ts text eol=lf
*.swift text eol=lf
*.cc text eol=lf
*.cpp text eol=lf
*.h text eol=lf
*.cmake text eol=lf
*.kt text eol=lf
*.java text eol=lf

# A retired test kept for reference (sound_manager_test.dart.disabled). The
# extension matches neither *.dart nor *.md above, so without this it falls
# through to core.autocrlf and is checked out CRLF while stored LF -- the same
# class of problem as the *.txt entry below.
*.dart.disabled text eol=lf

# Generated/plain text. `desiredFileName.txt` is rewritten by `flutter gen-l10n`
# on every build and is always written with LF, so without this it flips to LF
# while the checkout is CRLF and shows up as a modified file forever -- a diff
# with no content in it. Note *.json above does not cover it: the file holds
# JSON but is named .txt.
*.txt text eol=lf

# Binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
